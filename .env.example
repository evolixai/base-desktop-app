# Copy this file to .env and adjust the values for your environment.
#
#   cp .env.example .env

# Logging verbosity for the application.
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Default base URL for OpenAI-compatible provider requests.
# Example: https://opencode.ai/zen/v1
BASE_API_URL=https://opencode.ai/zen/v1
